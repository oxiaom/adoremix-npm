{
  "name": "@oxiaom/adoremix",
  "version": "1.0.101",
  "description": "AdoreMix broadcast server - cross-platform installer, runner and service manager",
  "bin": {
    "adoremix": "./bin/adoremix.js"
  },
  "main": "./src/index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=16"
  },
  "optionalDependencies": {
    "@oxiaom/adoremix-win32-x64": "^1.0.0",
    "@oxiaom/adoremix-linux-x64": "^1.0.0",
    "@oxiaom/adoremix-linux-arm64": "^1.0.0",
    "@oxiaom/adoremix-linux-arm": "^1.0.0",
    "@oxiaom/adoremix-darwin-arm64": "^1.0.0"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "ini": "^4.1.3",
    "pidusage": "^3.0.2",
    "fs-extra": "^11.2.0",
    "prompts": "^2.4.2"
  },
  "peerDependencies": {
    "node-windows": "^1.0.0-beta.8"
  },
  "peerDependenciesMeta": {
    "node-windows": {
      "optional": true
    }
  },
  "scripts": {
    "postinstall": "node ./bin/postinstall-hint.js"
  },
  "files": [
    "bin",
    "src",
    "templates",
    "tts",
    "webui",
    "config-manager",
    "audio8-assets",
    "CHANGELOG.md"
  ],
  "keywords": [
    "adoremix",
    "broadcast",
    "server",
    "qt",
    "installer",
    "changelog",
    "release-notes",
    "tts"
  ],
  "license": "MIT",
  "homepage": "https://oxiaom.github.io/adoremix-npm/",
  "repository": {
    "type": "git",
    "url": "https://github.com/oxiaom/adoremix-npm.git"
  }
}
